SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Use the Cloudflare Turnstile testing keys for local development.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=3x00000000000000000000FF
# Or bypass Turnstile entirely (no network request to Cloudflare):
# TURNSTILE_SKIP_VERIFICATION=true
# Disable origin validation when running frontend and worker on separate ports:
# DISABLE_ORIGIN_VALIDATION=true
