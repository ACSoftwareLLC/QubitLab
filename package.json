{
  "name": "qubitlab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build simulator --target web --out-dir ../src/wasm/pkg --release",
    "dev": "vite",
    "predev": "npm run sync:changelog",
    "build": "npm run build:wasm && tsc -b && vite build",
    "prebuild": "npm run sync:changelog",
    "build:worker": "npm run build",
    "sync:changelog": "tsx scripts/sync-changelog.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:worker": "npm run build:worker && ./scripts/test-worker.sh",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "predev:worker": "npm run build:worker",
    "dev:worker": "wrangler dev --local",
    "deploy": "npx wrangler deploy --env dev",
    "deploy:production": "npx wrangler deploy --env production",
    "db:seed:dev": "tsx scripts/seed-dev.ts",
    "check:deployment": "tsx scripts/check-deployment.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "bootstrap-icons": "^1.13.1",
    "hono": "^4.8.0",
    "konva": "^10.0.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-konva": "^19.2.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "three": "^0.185.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.0",
    "@eslint/js": "^9.39.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "tsx": "^4.23.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.10",
    "wasm-pack": "^0.15.0",
    "wrangler": "^4.13.0"
  }
}
